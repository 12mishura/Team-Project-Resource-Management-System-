# Copy to .env in the repository root on the server and fill in every value.
# Generate secrets with: openssl rand -base64 48

# Public address of the site. Caddy gets an HTTPS certificate for it automatically.
# Without a domain use the server IP with sslip.io, for example 13.48.0.10.sslip.io
SITE_ADDRESS=tasktracker.example.com

DB_USERNAME=tasktracker
DB_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
